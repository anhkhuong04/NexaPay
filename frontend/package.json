{
  "name": "nexapay-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "lint": "node ./node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs --check src e2e *.ts *.js *.json index.html",
    "format": "node ./node_modules/prettier/bin/prettier.cjs --write src e2e *.ts *.js *.json index.html"
  },
  "dependencies": {
    "@fluentui/react-components": "9.75.0",
    "@fluentui/react-icons": "2.0.345",
    "@hookform/resolvers": "7.0.1",
    "@tanstack/react-query": "5.105.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
